PULSE_PUBLIC_URL=https://pulse.jouwdomein.be
PULSE_GATEWAY_PUBLIC_URL=https://api.pulse.jouwdomein.be
PORT=8787
PULSE_ALLOWED_ORIGIN=https://jouw-pulse.vercel.app

# Supabase blijft uitsluitend de login/identiteitsbron.
SUPABASE_AUTH_URL=https://PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Gateway security. In Docker gebruik bij voorkeur *_FILE secrets.
PULSE_GATEWAY_SETUP_TOKEN=
PULSE_GATEWAY_SETUP_TOKEN_FILE=
PULSE_GATEWAY_MASTER_KEY=
PULSE_GATEWAY_MASTER_KEY_FILE=

# Aanbevolen beheerde Docker-modus.
PULSE_POSTGRES_AUTOCONFIG=0
PULSE_POSTGRES_HOST=postgres
PULSE_POSTGRES_PORT=5432
PULSE_POSTGRES_DB=pulse
PULSE_POSTGRES_USER=pulse_app
PULSE_POSTGRES_PASSWORD=
PULSE_POSTGRES_PASSWORD_FILE=
PULSE_POSTGRES_SSL=0
PULSE_POSTGRES_ALLOW_SELF_SIGNED=0

# Eigen bestandenopslag na migratie.
PULSE_FILE_ROOT=/pulse/files
PULSE_SOURCE_STORAGE_BUCKET=vlacora-hub-files
PULSE_FILE_MIGRATION_STRICT=1
