# Publieke PULSE website. Mag later wijzigen zonder datamigratie.
PULSE_PUBLIC_URL=https://pulse.jouwdomein.be
PULSE_ALLOWED_ORIGIN=https://pulse.jouwdomein.be

# Hosted Supabase remains the only authentication provider.
SUPABASE_AUTH_URL=https://PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Managed Docker PostgreSQL. Password is generated by the installer and never entered in the browser.
PULSE_POSTGRES_DB=pulse
PULSE_POSTGRES_USER=pulse_app

# Direct HTTP port for LAN/testing. PostgreSQL port 5432 is deliberately NOT published.
PULSE_GATEWAY_PORT=8787

# Optional HTTPS domain. If filled in, run the compose stack with profile "https".
PULSE_GATEWAY_DOMAIN=
PULSE_GATEWAY_PUBLIC_URL=
PULSE_GATEWAY_EMAIL=

PULSE_SOURCE_STORAGE_BUCKET=vlacora-hub-files
