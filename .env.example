# PULSE 0.25.0
# Current backend: Supabase (PostgreSQL + Auth + RLS).
# These public values may be configured in Vercel or through the existing login setup flow.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Never expose a Supabase service-role key through NEXT_PUBLIC_*.
# PULSE does not need a service-role key in the browser.

# FUTURE DATABASE MIGRATION
# A future pure PostgreSQL connection must remain server-side only.
# Do NOT prefix this with NEXT_PUBLIC_. It is deliberately not consumed by 0.21.0 yet;
# the superadmin database screen stores only non-secret migration target metadata.
VLACORA_POSTGRES_URL=
