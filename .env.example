# Later, when Supabase is connected:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Later, when the Windows agent is connected:
VLACORA_AGENT_SECRET=
ROTATION_API_SHARED_SECRET=
PLAYOUT_API_SHARED_SECRET=


# Radio API integration - SERVER SIDE ONLY on Vercel.
# You can use your fixed public IP here, e.g. https://203.0.113.10:5090
ROTATION_ONE_BASE_URL=
ROTATION_ONE_API_KEY=
ROTATION_ONE_STATUS_PATH=/api/v1/status
ROTATION_ONE_PLAYLIST_PATH=/api/v1/stations/{stationId}/playlists

PLAYOUT_ONE_BASE_URL=
PLAYOUT_ONE_API_KEY=
PLAYOUT_ONE_STATUS_PATH=/api/v1/status


# ============================================================
# VLACORA RADIO API SECURITY
# ============================================================
# Keep real radio API access OFF until the VLACORA site is protected.
RADIO_API_ENABLED=false

# Separate kill switch for any remote write/change operation.
RADIO_API_WRITE_ENABLED=false

# Block plain HTTP by default. Prefer HTTPS to your fixed public IP / hostname.
RADIO_API_ALLOW_INSECURE_HTTP=true

# Temporary protection for the whole radio-API layer until Supabase Auth/RBAC is connected.
# Use a long unique password and configure both values only in Vercel Environment Variables.
VLACORA_BASIC_AUTH_USER=
VLACORA_BASIC_AUTH_PASSWORD=

# Used to reject cross-origin write calls. Example:
# https://vlacora-hub.vercel.app
VLACORA_PUBLIC_ORIGIN=

# Rotation One
ROTATION_ONE_BASE_URL=
ROTATION_ONE_API_KEY=
ROTATION_ONE_API_KEY_HEADER=Authorization
ROTATION_ONE_API_KEY_PREFIX=Bearer
ROTATION_ONE_STATUS_PATH=/api/v1/status
ROTATION_ONE_STATIONS_PATH=/api/v1/stations
ROTATION_ONE_PLAYLIST_PATH=/api/v1/stations/{stationId}/playlists
ROTATION_ONE_PLAYLIST_WRITE_PATH=/api/v1/stations/{stationId}/playlists
ROTATION_ONE_PLAYLIST_WRITE_METHOD=PUT

# Playout One
PLAYOUT_ONE_BASE_URL=
PLAYOUT_ONE_API_KEY=
PLAYOUT_ONE_API_KEY_HEADER=Authorization
PLAYOUT_ONE_API_KEY_PREFIX=Bearer
PLAYOUT_ONE_STATUS_PATH=/api/v1/status
PLAYOUT_ONE_STATIONS_PATH=/api/v1/stations
PLAYOUT_ONE_NOWPLAYING_PATH=/api/v1/stations/{stationId}/nowplaying


# HTTP fixed-IP setup
# Your Rotation One / Playout One APIs can be configured as plain HTTP URLs:
# ROTATION_ONE_BASE_URL=http://203.0.113.10:5090
# PLAYOUT_ONE_BASE_URL=http://203.0.113.10:5190
#
# This project supports it when RADIO_API_ALLOW_INSECURE_HTTP=true.
# IMPORTANT: HTTP does not encrypt the API key or traffic. Keep the API keys server-side,
# use long random secrets, limit the exposed API endpoints, and firewall the radio server.


# Optional but recommended for fixed public IPs.
# Comma-separated host/IP allow-list. Example: 203.0.113.10,203.0.113.11
RADIO_API_ALLOWED_HOSTS=
