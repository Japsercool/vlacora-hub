# PULSE 0.32.0
# Supabase blijft uitsluitend de vaste login/identiteitslaag.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Nooit service-role-, PostgreSQL- of Gateway-secrets in NEXT_PUBLIC_* zetten.
# De eigen PostgreSQL-login wordt door de PULSE Docker-server gegenereerd en
# uitsluitend server-side bewaard.

# De website- en Gateway-URL worden via Beheer > Database-backend gekoppeld.
# Een domeinwissel vereist geen datamigratie.
